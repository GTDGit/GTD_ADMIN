# Admin frontend calls its backend via same-origin /api (Next.js rewrites in
# next.config.js proxy /api/* to API_BACKEND_URL). The backend is now the
# Gateway (admin Go service), not the API.

# Client-side: base URL for requests (default /api = same-origin proxy, no CORS)
NEXT_PUBLIC_API_URL=/api

# Server-side only (next build/start): backend target for the /api rewrite.
# Point this at the Gateway origin (admin backend), NOT the API.
#   Development (current target): https://dev-gateway.gtd.co.id
#   Production:                   https://gateway.gtd.co.id
# If unset, next.config.js falls back to http://localhost:8080 for local dev.
API_BACKEND_URL=https://dev-gateway.gtd.co.id

# Client auth (for liveness etc.) — placeholders only, never commit real secrets
NEXT_PUBLIC_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_CLIENT_SECRET=your_client_secret_here
