# Copy to .env.local and fill in values.
# The admin frontend uses /api by default; Next.js (next.config.js) rewrites
# /api/* to API_BACKEND_URL. The backend is now the Gateway (admin Go service).
#
# Set API_BACKEND_URL to the Gateway origin:
#   Development (current target): https://dev-gateway.gtd.co.id
#   Production:                   https://gateway.gtd.co.id
# If unset, next.config.js falls back to http://localhost:8080 for local dev.

NEXT_PUBLIC_API_URL=/api
API_BACKEND_URL=https://dev-gateway.gtd.co.id

NEXT_PUBLIC_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_CLIENT_SECRET=your_client_secret_here

# Optional: AWS for Face Liveness
# NEXT_PUBLIC_AWS_REGION=ap-northeast-1
# NEXT_PUBLIC_AWS_ACCESS_KEY_ID=your_aws_access_key_id
# NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
